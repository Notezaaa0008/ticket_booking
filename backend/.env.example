# ===== required (server ไม่เริ่มถ้าขาด) =====
DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket_booking?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

# ===== optional (มีค่า default) =====
TEST_DATABASE_URL=postgres://ticket:ticket@localhost:5432/ticket_booking_test?sslmode=disable
PORT=8080
CORS_ORIGIN=http://localhost:3000
SEAT_HOLD_TTL_SECONDS=600
MOCK_GATEWAY_ENABLED=true

# ===== seed (ใช้เฉพาะ cmd/seed) =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User1234!